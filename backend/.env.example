# ─── Core (required) ───
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_long_random_secret
GROQ_API_KEY=your_groq_api_key
PORT=5000

# ─── Email notifications (optional) ───
# If SMTP_HOST is unset, all email sends become silent no-ops and the
# app works normally without email. Set these to enable:
#  - contract delivery to clients on "Send to client"
#  - freelancer alerts on new client comments and signatures
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AI ContractKit <no-reply@yourdomain.com>

# Public app URL used in email links (the React frontend)
APP_URL=http://localhost:5173
